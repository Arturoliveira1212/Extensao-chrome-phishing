{
    "manifest_version": 3,
    "name": "PhishGuard - Proteção Anti-Phishing",
    "version": "1.0.0",
    "description": "Extensão de proteção contra phishing para usuários. Analisa links e detecta ameaças em tempo real.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "webNavigation",
        "notifications"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}